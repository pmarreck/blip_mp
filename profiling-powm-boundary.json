      "comparison": "absolute",
      "command": [
        "blip-mp-powm-probe",
        "paired",
        "{sizes}"
      ],
      "sizes": [
        64,
        128,
        256,
        384,
        512,
        768,
        1024,
        1536
      ],
      "bounds": [
        0.1,
        1000000000
      ],

#!/usr/bin/env bash
# Prepare and execute every correctness suite inside Nix sandboxes.
# --keep-going collects failures from independent checks; --no-link leaves
# the checkout's publication links untouched.
set -u

started=$SECONDS
system=$(nix eval --raw --impure --expr 'builtins.currentSystem') || exit 1
printf 'Preparing and checking ReleaseSafe units, C API, GMP comparisons and CLI tests through Nix.\n'
if nix build --no-link --keep-going --print-build-logs \
	".#checks.$system.test" \
	".#checks.$system.integration" \
	".#checks.$system.build-driver" \
	".#checks.$system.probe-cli" \
	".#checks.$system.inverse-probe-cli" \
	".#checks.$system.division-probe-cli" \
	".#checks.$system.multiplication-probe-cli"; then
	printf 'All test groups passed (Nix checks may be cached).\n'
	status=0
else
	printf 'One or more required test groups failed or could not be built.\n' >&2
	status=1
fi
printf 'Total Nix preparation/check time: %d seconds.\n' "$((SECONDS - started))"
exit "$status"

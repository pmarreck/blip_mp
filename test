#!/usr/bin/env bash
# Top-level test runner. Accumulates subtest exit codes; returns nonzero
# if any failed. Per CLAUDE.md: never `set -e` here — that masks
# expected-failure assertions inside test runners.
set -u

fail_count=0

run() {
	local label="$1"
	shift
	printf '\n=== %s ===\n' "$label"
	if "$@"; then
		printf '[PASS] %s\n' "$label"
	else
		printf '[FAIL] %s (exit %d)\n' "$label" $?
		fail_count=$((fail_count + 1))
	fi
}

# Unit tests — Zig core, run via Nix sandbox for determinism.
run "zig unit tests (nix)" nix build ".#checks.$(nix eval --raw --impure --expr 'builtins.currentSystem').test" --print-build-logs

# Cross-validation against GMP — every blip_mp result must equal GMP's.
# Builds the cross_check exe (linked against GMP) and runs random
# add/sub/mul comparisons across 18 bit-widths.
run "cross-validation vs GMP" bash -c '
	nix build .#packages.$(nix eval --raw --impure --expr "builtins.currentSystem").bench --print-build-logs >/dev/null 2>&1 \
		|| { echo "build failed"; exit 1; }
	./result/bin/cross_check
'

# C FFI smoke test — dogfoods include/blip_mp.h via a pure-C consumer.
# Builds the c-smoke binary (which links against libblip_mp_c.a) and runs it.
# Per CLAUDE.md, this validates the FFI boundary that downstream Rust/Lua/
# Python bindings will depend on.
run "c FFI smoke" bash -c '
	nix develop -c zig build c-smoke-run --summary none 2>&1
'

# bp CLI smoke test — exercises the RPN calculator end-to-end via the
# same C FFI. Includes the IEEE754-disruption headline (0.1 0.2 + → 0.3).
run "bp CLI smoke" bash -c '
	nix build --print-build-logs >/dev/null 2>&1 || { echo "bp build failed"; exit 1; }
	BP_BIN=./result/bin/bp ./tests/cli/bp_smoke.sh
'

if [ "$fail_count" -eq 0 ]; then
	printf '\nAll test groups passed.\n'
	exit 0
else
	printf '\n%d test group(s) failed.\n' "$fail_count" >&2
	exit 1
fi

{
  "schema": "performance-project/v1",
  "project": "blip_mp",
  "history_url": "file:///var/lib/performance-profiling",
  "identity": {
    "runtime": "Zig-0.16.0",
    "build_mode": "ReleaseFast",
    "concurrency": 1
  },
  "cases": [
    {
      "name": "powm_1core",
      "definition": "powm-gmp-verified-v1",
      "cores": 1,
      "processes": 5,
      "mode": "bm",
      "metric": "cpu_ns",
      "comparison": "absolute",
      "command": [
        "blip-mp-powm-probe",
        "{sizes}"
      ],
      "sizes": [
        512,
        1024,
        2048,
        3072
      ],
      "bounds": [
        0.1,
        1000000000
      ],
      "policy": {
        "max_cv": 0.1
      },
      "timeout_ms": 120000
    },
    {
      "name": "powm_12core",
      "definition": "powm-gmp-verified-v1",
      "cores": 12,
      "processes": 5,
      "mode": "bm",
      "metric": "cpu_ns",
      "comparison": "absolute",
      "command": [
        "blip-mp-powm-probe",
        "{sizes}"
      ],
      "sizes": [
        512,
        1024,
        2048,
        3072
      ],
      "bounds": [
        0.1,
        1000000000
      ],
      "policy": {
        "max_cv": 0.1
      },
      "timeout_ms": 120000
    }
  ]
}
